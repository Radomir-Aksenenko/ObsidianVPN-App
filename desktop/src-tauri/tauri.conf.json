{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ObsidianVPN",
  "version": "1.1.1",
  "identifier": "com.obsidianvpn.client",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ObsidianVPN",
        "width": 400,
        "height": 680,
        "minWidth": 380,
        "minHeight": 620,
        "maxWidth": 440,
        "maxHeight": 760,
        "resizable": false,
        "decorations": false,
        "center": true,
        "visible": true,
        "focus": true,
        "backgroundColor": "#0B0B10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/keyserver.py",
      "resources/obsidian-client.exe",
      "resources/obsidian-server-linux",
      "resources/wintun.dll"
    ]
  }
}
